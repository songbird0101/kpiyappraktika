< Window x: Class = "EmployeeManager.MainWindow"
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns: x = "http://schemas.microsoft.com/winfx/2006/xaml"
        Title = "Автоматизация учета сотрудников" Height = "600" Width = "800"
        WindowStartupLocation = "CenterScreen" >
    < Grid Margin = "15" >
        < Grid.RowDefinitions >
            < RowDefinition Height = "Auto" />
            < RowDefinition Height = "Auto" />
            < RowDefinition Height = "Auto" />
            < RowDefinition Height = "*" />
            < RowDefinition Height = "Auto" />
        </ Grid.RowDefinitions >

        < TextBlock Text = "Учет сотрудников" FontSize = "28" FontWeight = "Bold"
                   HorizontalAlignment = "Center" Margin = "0,0,0,15"
                   Foreground = "#2C3E50" />

        < ProgressBar x: Name = "pbLoading" Grid.Row = "1" Height = "25" Margin = "0,0,0,15"
                     IsIndeterminate = "True" Visibility = "Collapsed" />

        < GroupBox Header = "Фильтр по отделу" Grid.Row = "2" Margin = "0,0,0,15"
                  FontWeight = "Bold" BorderBrush = "#3498DB" BorderThickness = "2" >
            < ComboBox x: Name = "cbDepartment" ItemsSource = "{Binding Departments}"
                      DisplayMemberPath = "Name" SelectedItem = "{Binding SelectedDepartment}"
                      Margin = "15,10" Height = "35"
                      SelectionChanged = "cbDepartment_SelectionChanged" />
        </ GroupBox >

        < GroupBox Header = "Список сотрудников" Grid.Row = "3" Margin = "0,0,0,15"
                  FontWeight = "Bold" BorderBrush = "#3498DB" BorderThickness = "2" >
            < ListView x: Name = "lvEmployees" ItemsSource = "{Binding Employees}"
                      SelectedItem = "{Binding SelectedEmployee}"
                      Margin = "10" Background = "#F8F9FA" >
                < ListView.View >
                    < GridView >
                        < GridViewColumn Header = "ФИО" Width = "200" DisplayMemberBinding = "{Binding FullName}" />
                        < GridViewColumn Header = "Должность" Width = "150" DisplayMemberBinding = "{Binding Position}" />
                        < GridViewColumn Header = "Отдел" Width = "150" DisplayMemberBinding = "{Binding DepartmentName}" />
                        < GridViewColumn Header = "Телефон" Width = "150" DisplayMemberBinding = "{Binding Phone}" />
                        < GridViewColumn Header = "Email" Width = "180" DisplayMemberBinding = "{Binding Email}" />
                    </ GridView >
                </ ListView.View >
            </ ListView >
        </ GroupBox >

        < GroupBox Header = "Информация о сотруднике" Grid.Row = "4" Margin = "0,0,0,0"
                  FontWeight = "Bold" BorderBrush = "#3498DB" BorderThickness = "2" >
            < Grid Margin = "15" >
                < Grid.ColumnDefinitions >
                    < ColumnDefinition Width = "100" />
                    < ColumnDefinition Width = "*" />
                    < ColumnDefinition Width = "100" />
                    < ColumnDefinition Width = "*" />
                </ Grid.ColumnDefinitions >
                < Grid.RowDefinitions >
                    < RowDefinition Height = "Auto" />
                    < RowDefinition Height = "Auto" />
                    < RowDefinition Height = "Auto" />
                    < RowDefinition Height = "Auto" />
                </ Grid.RowDefinitions >

                < Label Content = "ФИО:" Grid.Row = "0" Grid.Column = "0" FontWeight = "SemiBold" />
                < TextBox x: Name = "tbFullName" Grid.Row = "0" Grid.Column = "1" Margin = "5" Height = "30"
                         Text = "{Binding SelectedEmployee.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                < Label Content = "Должность:" Grid.Row = "0" Grid.Column = "2" FontWeight = "SemiBold" />
                < TextBox x: Name = "tbPosition" Grid.Row = "0" Grid.Column = "3" Margin = "5" Height = "30"
                         Text = "{Binding SelectedEmployee.Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                < Label Content = "Отдел:" Grid.Row = "1" Grid.Column = "0" FontWeight = "SemiBold" />
                < ComboBox x: Name = "cbEmployeeDepartment" Grid.Row = "1" Grid.Column = "1" Margin = "5" Height = "30"
                          ItemsSource = "{Binding Departments}"
                          DisplayMemberPath = "Name"
                          SelectedItem = "{Binding SelectedEmployee.Department, Mode=TwoWay}" />

                < Label Content = "Телефон:" Grid.Row = "1" Grid.Column = "2" FontWeight = "SemiBold" />
                < TextBox x: Name = "tbPhone" Grid.Row = "1" Grid.Column = "3" Margin = "5" Height = "30"
                         Text = "{Binding SelectedEmployee.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                < Label Content = "Email:" Grid.Row = "2" Grid.Column = "0" FontWeight = "SemiBold" />
                < TextBox x: Name = "tbEmail" Grid.Row = "2" Grid.Column = "1" Grid.ColumnSpan = "3" Margin = "5" Height = "30"
                         Text = "{Binding SelectedEmployee.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                < StackPanel Grid.Row = "3" Grid.ColumnSpan = "4" Orientation = "Horizontal"
                            HorizontalAlignment = "Center" Margin = "0,15,0,0" >
                    < Button x: Name = "btnAdd" Content = "Добавить" Width = "100" Height = "35" Margin = "5"
                            Background = "#27AE60" Foreground = "White" FontWeight = "Bold"
                            Command = "{Binding AddCommand}" />
                    < Button x: Name = "btnUpdate" Content = "Редактировать" Width = "100" Height = "35" Margin = "5"
                            Background = "#F39C12" Foreground = "White" FontWeight = "Bold"
                            Command = "{Binding UpdateCommand}" />
                    < Button x: Name = "btnDelete" Content = "Удалить" Width = "100" Height = "35" Margin = "5"
                            Background = "#E74C3C" Foreground = "White" FontWeight = "Bold"
                            Command = "{Binding DeleteCommand}" />
                    < Button x: Name = "btnClear" Content = "Очистить" Width = "100" Height = "35" Margin = "5"
                            Background = "#95A5A6" Foreground = "White" FontWeight = "Bold"
                            Command = "{Binding ClearCommand}" />
                </ StackPanel >
            </ Grid >
        </ GroupBox >
    </ Grid >
</ Window >