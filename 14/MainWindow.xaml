<Window x:Class="EmployeeManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоматизация учета сотрудников" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="EmployeeCardTemplate">
            <Border BorderBrush="#3498DB" BorderThickness="1" CornerRadius="8"
                    Background="#F8F9FA" Padding="10" Margin="5">
                <StackPanel>
                    <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding Position}" FontSize="14"
                               Foreground="#7F8C8D" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ControlTemplate x:Key="AddButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="25">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="15,8,15,8"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E8449"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A6B3B"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Учет сотрудников" FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"
                   Foreground="#2C3E50"/>

        <GroupBox Header="Фильтр по должности" Grid.Row="1" Margin="0,0,0,15"
                  FontWeight="Bold" BorderBrush="#3498DB" BorderThickness="2">
            <StackPanel Orientation="Horizontal" Margin="15,10">
                <RadioButton x:Name="rbAll" Content="Все" IsChecked="True"
                             Margin="0,0,25,0" Checked="Filter_Changed"
                             Foreground="#2C3E50" FontWeight="SemiBold"/>
                <RadioButton x:Name="rbManager" Content="Менеджер"
                             Margin="0,0,25,0" Checked="Filter_Changed"
                             Foreground="#2C3E50" FontWeight="SemiBold"/>
                <RadioButton x:Name="rbDeveloper" Content="Разработчик"
                             Margin="0,0,25,0" Checked="Filter_Changed"
                             Foreground="#2C3E50" FontWeight="SemiBold"/>
                <RadioButton x:Name="rbDesigner" Content="Дизайнер"
                             Margin="0,0,25,0" Checked="Filter_Changed"
                             Foreground="#2C3E50" FontWeight="SemiBold"/>
                <RadioButton x:Name="rbAnalyst" Content="Аналитик"
                             Margin="0,0,25,0" Checked="Filter_Changed"
                             Foreground="#2C3E50" FontWeight="SemiBold"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Список сотрудников" Grid.Row="2" Margin="0,0,0,15"
                  FontWeight="Bold" BorderBrush="#3498DB" BorderThickness="2">
            <ListBox x:Name="lbEmployees" ItemsSource="{Binding Employees}"
                     SelectionChanged="lbEmployees_SelectionChanged"
                     Margin="10" Background="#F8F9FA"
                     ItemTemplate="{StaticResource EmployeeCardTemplate}"/>
        </GroupBox>

        <GroupBox Header="Информация о сотруднике" Grid.Row="3" Margin="0,0,0,0"
                  FontWeight="Bold" BorderBrush="#3498DB" BorderThickness="2">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="ФИО:" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"/>
                <TextBox x:Name="tbFullName" Grid.Row="0" Grid.Column="1" Margin="5" Height="30"
                         Text="{Binding SelectedEmployee.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Должность:" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbPosition" Grid.Row="0" Grid.Column="3" Margin="5" Height="30"
                          SelectedValue="{Binding SelectedEmployee.Position, Mode=TwoWay}"
                          IsReadOnly="True">
                    <ComboBoxItem Content="Менеджер"/>
                    <ComboBoxItem Content="Разработчик"/>
                    <ComboBoxItem Content="Дизайнер"/>
                    <ComboBoxItem Content="Аналитик"/>
                </ComboBox>

                <Label Content="Отдел:" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold"/>
                <TextBox x:Name="tbDepartment" Grid.Row="1" Grid.Column="1" Margin="5" Height="30"
                         Text="{Binding SelectedEmployee.Department, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Телефон:" Grid.Row="1" Grid.Column="2" FontWeight="SemiBold"/>
                <TextBox x:Name="tbPhone" Grid.Row="1" Grid.Column="3" Margin="5" Height="30"
                         Text="{Binding SelectedEmployee.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Email:" Grid.Row="2" Grid.Column="0" FontWeight="SemiBold"/>
                <TextBox x:Name="tbEmail" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Height="30"
                         Text="{Binding SelectedEmployee.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="btnAdd" Content="Добавить сотрудника" Width="160" Height="40" Margin="5"
                            Background="#27AE60" Foreground="White" FontWeight="Bold"
                            Click="btnAdd_Click"
                            Template="{StaticResource AddButtonTemplate}"/>
                    <Button x:Name="btnUpdate" Content="Редактировать" Width="120" Height="40" Margin="5"
                            Background="#F39C12" Foreground="White" FontWeight="Bold"
                            Click="btnUpdate_Click"/>
                    <Button x:Name="btnDelete" Content="Удалить" Width="100" Height="40" Margin="5"
                            Background="#E74C3C" Foreground="White" FontWeight="Bold"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnClear" Content="Очистить" Width="100" Height="40" Margin="5"
                            Background="#95A5A6" Foreground="White" FontWeight="Bold"
                            Click="btnClear_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>