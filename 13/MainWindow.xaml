< Window x: Class = "EmployeeManager.MainWindow"
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns: x = "http://schemas.microsoft.com/winfx/2006/xaml"
        Title = "Автоматизация учета сотрудников" Height = "550" Width = "800"
        WindowStartupLocation = "CenterScreen" >


    < Window.InputBindings >
        < KeyBinding Key = "N" Modifiers = "Ctrl" Command = "{Binding AddEmployeeCommand}" />
        < KeyBinding Key = "E" Modifiers = "Ctrl" Command = "{Binding EditEmployeeCommand}" />
        < KeyBinding Key = "D" Modifiers = "Ctrl" Command = "{Binding DeleteEmployeeCommand}" />
    </ Window.InputBindings >


    < DockPanel >
        < Menu DockPanel.Dock = "Top" >
            < MenuItem Header = "Файл" >
                < MenuItem Header = "Выход" Click = "Exit_Click" />
            </ MenuItem >
            < MenuItem Header = "Сотрудники" >
                < MenuItem Header = "Добавить сотрудника" Command = "{Binding AddEmployeeCommand}" />
                < MenuItem Header = "Редактировать сотрудника" Command = "{Binding EditEmployeeCommand}" />
                < MenuItem Header = "Удалить сотрудника" Command = "{Binding DeleteEmployeeCommand}" />
                < Separator />
                < MenuItem Header = "Обновить список" Click = "Refresh_Click" />
            </ MenuItem >
            < MenuItem Header = "Отчёты" >
                < MenuItem Header = "Отчёт по должностям" Click = "ReportByPosition_Click" />
                < MenuItem Header = "Отчёт по отделам" Click = "ReportByDepartment_Click" />
                < MenuItem Header = "Полный список" Click = "ReportFullList_Click" />
            </ MenuItem >
            < MenuItem Header = "Настройки" >
                < MenuItem Header = "Настройки приложения" Click = "Settings_Click" />
                < MenuItem Header = "О программе" Click = "About_Click" />
            </ MenuItem >
        </ Menu >

        < Grid Margin = "10" >
            < Grid.RowDefinitions >
                < RowDefinition Height = "Auto" />
                < RowDefinition Height = "*" />
                < RowDefinition Height = "Auto" />
            </ Grid.RowDefinitions >

            < TextBlock Text = "Учет сотрудников" FontSize = "24" FontWeight = "Bold"
                       HorizontalAlignment = "Center" Margin = "0,0,0,15" />

            < ListView x: Name = "lvEmployees" Grid.Row = "1"
                      SelectionChanged = "lvEmployees_SelectionChanged"
                      Margin = "0,10" Background = "#F8F9FA" >
                < ListView.View >
                    < GridView >
                        < GridViewColumn Header = "ФИО" Width = "200" DisplayMemberBinding = "{Binding FullName}" />
                        < GridViewColumn Header = "Должность" Width = "150" DisplayMemberBinding = "{Binding Position}" />
                        < GridViewColumn Header = "Отдел" Width = "150" DisplayMemberBinding = "{Binding Department}" />
                        < GridViewColumn Header = "Телефон" Width = "150" DisplayMemberBinding = "{Binding Phone}" />
                        < GridViewColumn Header = "Email" Width = "200" DisplayMemberBinding = "{Binding Email}" />
                    </ GridView >
                </ ListView.View >
            </ ListView >

            < StatusBar Grid.Row = "2" >
                < StatusBarItem >
                    < TextBlock x: Name = "tbStatus" Text = "Готов" />
                </ StatusBarItem >
            </ StatusBar >
        </ Grid >
    </ DockPanel >
</ Window >